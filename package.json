    "dev": "bun run ./src/dev-entry.ts",
    "start": "bun run ./src/dev-entry.ts",
    "version:restored": "bun run ./src/dev-entry.ts --version",
    "validate:restoration": "node scripts/validate-restoration.mjs"
  },
